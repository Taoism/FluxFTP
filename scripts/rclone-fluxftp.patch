diff --git a/lib/oauthutil/fluxftp_callback_test.go b/lib/oauthutil/fluxftp_callback_test.go
new file mode 100644
--- /dev/null
+++ b/lib/oauthutil/fluxftp_callback_test.go
@@ -0,0 +1,25 @@
+package oauthutil
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLocalhostCallbackAddress(t *testing.T) {
+	for _, tc := range []struct{ redirect, address string }{
+		{"http://localhost:18342/", "127.0.0.1:18342"},
+		{RedirectLocalhostURL, bindAddress},
+		{RedirectURL, bindAddress},
+		{RedirectPublicURL, bindAddress},
+		{RedirectPublicSecureURL, bindAddress},
+	} {
+		address, err := callbackAddress(tc.redirect)
+		require.NoError(t, err)
+		require.Equal(t, tc.address, address)
+	}
+	for _, redirect := range []string{"http://localhost:99999/", "http://localhost:0/", "http://localhost:bad/"} {
+		_, err := callbackAddress(redirect)
+		require.Error(t, err)
+	}
+}
diff --git a/backend/onedrive/fluxftp_drive_test.go b/backend/onedrive/fluxftp_drive_test.go
new file mode 100644
--- /dev/null
+++ b/backend/onedrive/fluxftp_drive_test.go
@@ -0,0 +1,44 @@
+package onedrive
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/rclone/rclone/backend/onedrive/api"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/lib/rest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFluxFTPDefaultDriveSelection(t *testing.T) {
+	for _, included := range []bool{true, false} {
+		t.Run(map[bool]string{true: "included", false: "missing"}[included], func(t *testing.T) {
+			primary := api.DriveResource{DriveID: "primary", DriveName: "OneDrive", DriveType: "personal"}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				if r.URL.Path == "/me/drive" {
+					require.NoError(t, json.NewEncoder(w).Encode(primary))
+					return
+				}
+				require.Equal(t, "/me/drives", r.URL.Path)
+				drives := []api.DriveResource{{DriveID: "other", DriveName: "Other", DriveType: "personal"}}
+				if included {
+					drives = append(drives, primary)
+				}
+				require.NoError(t, json.NewEncoder(w).Encode(api.DrivesResponse{Drives: drives}))
+			}))
+			defer server.Close()
+			out, err := chooseDrive(context.Background(), "test", configmap.Simple{}, rest.NewClient(server.Client()),
+				chooseDriveOpt{opts: rest.Opts{Method: "GET", RootURL: server.URL, Path: "/me/drives"}})
+			require.NoError(t, err)
+			require.Equal(t, "primary", out.Option.Default)
+			require.Len(t, out.Option.Examples, 2)
+			require.Equal(t, "primary", out.Option.Examples[0].Value)
+			require.Contains(t, out.Option.Examples[0].Help, "default drive")
+			require.Equal(t, "other", out.Option.Examples[1].Value)
+		})
+	}
+}
