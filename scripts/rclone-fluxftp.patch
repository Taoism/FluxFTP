+// callbackAddress binds localhost redirects to their requested IPv4 loopback port.
+func callbackAddress(redirect string) (string, error) {
+	u, err := url.Parse(redirect)
+	if err != nil {
+		return "", errors.New("invalid OAuth callback URL")
+	}
+	if u.Scheme == "http" && u.Hostname() == "localhost" && u.Port() != "" {
+		port, err := strconv.Atoi(u.Port())
+		if err != nil || port < 1 || port > 65535 {
+			return "", errors.New("invalid OAuth callback port")
+		}
+		return net.JoinHostPort("127.0.0.1", u.Port()), nil
+	}
+	return bindAddress, nil
+}
